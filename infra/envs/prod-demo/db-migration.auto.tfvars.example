# Copy the required values into your non-committed terraform.tfvars on migration day.
# No secrets belong in Terraform variables for this workflow.

enable_db_migration_storage = true
enable_db_migration_host    = true

# Increase this if the combined SQL/custom dumps and extracted files need more space.
db_migration_instance_type   = "t3.micro"
db_migration_root_volume_size = 30

# Keep the encrypted S3 backup long enough to validate RDS and take a snapshot.
db_migration_backup_expiration_days            = 90
db_migration_noncurrent_expiration_days         = 30

# Protect the bucket from accidental Terraform deletion while it contains backups.
db_migration_bucket_force_destroy = false
